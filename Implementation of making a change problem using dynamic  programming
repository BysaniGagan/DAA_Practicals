def make_change(coins, amount):
    # dp[i] = minimum number of coins needed to make amount i
    dp = [float('inf')] * (amount + 1)

    # No coins are needed to make amount 0
    dp[0] = 0

    # Compute solutions for amounts 1 through amount
    for i in range(1, amount + 1):
        for coin in coins:
            if coin <= i:
                dp[i] = min(dp[i], dp[i - coin] + 1)

    # If amount cannot be formed
    if dp[amount] == float('inf'):
        return -1

    return dp[amount]


# Example
coins = [1, 5, 10, 25]
amount = 36
result = make_change(coins, amount)
print("Minimum number of coins:", result)


Output:
Minimum number of coins: 3

For 36, an optimal solution is: 25 + 10 + 1 = 36
