# Prim's Algorithm

INF = 999999

def prim(graph, n):
    selected = [False] * n
    selected[0] = True

    total_cost = 0

    print("Edge\tWeight")

    for _ in range(n - 1):
        minimum = INF
        x = 0
        y = 0

        for i in range(n):
            if selected[i]:
                for j in range(n):
                    if not selected[j] and graph[i][j]:
                        if graph[i][j] < minimum:
                            minimum = graph[i][j]
                            x = i
                            y = j

        print(f"{x} - {y}\t{minimum}")

        total_cost += minimum
        selected[y] = True

    print("Minimum Cost =", total_cost)


# Adjacency matrix
graph = [
