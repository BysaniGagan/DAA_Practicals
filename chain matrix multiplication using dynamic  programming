#include <iostream>
#include <climits>
using namespace std;

void matrixChainOrder(int p[], int n) {
    int dp[n][n];

    // Cost is zero when there is only one matrix
    for (int i = 1; i < n; i++)
        dp[i][i] = 0;

    // Length of chain
    for (int len = 2; len < n; len++) {
        for (int i = 1; i < n - len + 1; i++) {
            int j = i + len - 1;
            dp[i][j] = INT_MAX;

            for (int k = i; k < j; k++) {
                int cost = dp[i][k] + dp[k + 1][j]
                         + p[i - 1] * p[k] * p[j];

                if (cost < dp[i][j])
                    dp[i][j] = cost;
            }
        }
    }

    cout << "Minimum number of multiplications = "
         << dp[1][n - 1] << endl;
}

int main() {
    // A1 = 10x20, A2 = 20x30, A3 = 30x40
    // A4 = 40x30
    int p[] = {10, 20, 30, 40, 30};
    int n = sizeof(p) / sizeof(p[0]);

    matrixChainOrder(p, n);

    return 0;
}

